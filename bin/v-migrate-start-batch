#!/usr/bin/env bash
# info: start transfers for multiple users sequentially in background
# options: SESSION ACCEPT_WARNINGS USER [USER...]
set -euo pipefail
source /usr/local/hestia-migrate/lib/common.sh
require_root

session=${1-}
accept=${2:-no}
shift 2 || true
[[ -n "$session" ]] || die_json 2 "SESSION required"
[[ $# -ge 1 ]] || die_json 2 "at least one USER required"
[[ -d "$(session_dir "$session")" ]] || die_json 2 "unknown session"

mkdir -p "$MIGRATE_DATA/jobs" "$MIGRATE_LOG_DIR"
chmod 700 "$MIGRATE_DATA/jobs"

batch_id=$(date +%Y%m%d%H%M%S)
jobs_file=$(mktemp)
batch_log="$MIGRATE_DATA/jobs/batch-${batch_id}.log"

{
	echo "#!/bin/bash"
	echo "set +e"
	echo "SESSION=$(printf '%q' "$session")"
	echo "ACCEPT=$(printf '%q' "$accept")"
	echo "echo \"[batch $batch_id] start \$(date -Is)\""
	for u in "$@"; do
		echo "echo \"[batch] starting user $(printf '%q' "$u")\""
		echo "/usr/local/hestia/bin/v-migrate-start \"\$SESSION\" $(printf '%q' "$u") \"\$ACCEPT\""
		echo "rc=\$?"
		echo "echo \"[batch] user $(printf '%q' "$u") exit \$rc\""
		echo "sleep 2"
	done
	echo "echo \"[batch $batch_id] done \$(date -Is)\""
} >"$jobs_file"
chmod 700 "$jobs_file"

nohup bash "$jobs_file" >"$batch_log" 2>&1 &
pid=$!
echo "$pid" >"$MIGRATE_DATA/jobs/batch-${batch_id}.pid"

# Wait for first job directory (v-migrate-transfer creates it)
first_job=""
first_user=$1
for _ in $(seq 1 80); do
	sleep 0.25
	if ! kill -0 "$pid" 2>/dev/null; then
		# batch shell already exited — show why
		die_json 6 "batch exited before creating jobs; log: $(tail -n 30 "$batch_log" 2>/dev/null | tr '\n' ' ')"
	fi
	cand=$(ls -1dt "$MIGRATE_DATA/jobs/"*-"$first_user" 2>/dev/null | head -n1 || true)
	if [[ -n "$cand" && -d "$cand" ]]; then
		first_job=$(basename "$cand")
		break
	fi
done

if [[ -z "$first_job" ]]; then
	die_json 6 "no job created for $first_user; pid=$pid log=$batch_log :: $(tail -n 40 "$batch_log" 2>/dev/null | tr '\n' ' ')"
fi

users_json=$(printf '%s\n' "$@" | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')
printf '{"ok":true,"pid":%s,"first_job":"%s","batch_log":"%s","users":%s,"message":"batch started"}\n' \
	"$pid" "$first_job" "$(json_escape "$batch_log")" "$users_json"
