#!/usr/bin/env bash
# info: prep PHP (optional) then transfer users sequentially in background
# options: SESSION ACCEPT_WARNINGS ACCEPT_SOFTWARE INSTALL_PHP REMAP_PHP USER [USER...]
#
# INSTALL_PHP: comma-separated versions (e.g. 8.3,8.4) or "-" / "none"
# REMAP_PHP:   comma-separated from:to pairs (e.g. 8.2:8.5) or "-" / "none"
#
# Runs v-migrate-prep-php once for the batch, then v-migrate-transfer one user
# at a time. Batch progress is written to batch-<id>.progress.json.
set -euo pipefail
source /usr/local/hestia-migrate/lib/common.sh
require_root

session=${1-}
accept=${2:-no}
accept_sw=${3:-no}
install_php=${4:--}
remap_php=${5:--}
shift 5 || true
[[ -n "$session" ]] || die_json 2 "SESSION required"
[[ $# -ge 1 ]] || die_json 2 "at least one USER required"
[[ -d "$(session_dir "$session")" ]] || die_json 2 "unknown session"

mkdir -p "$MIGRATE_DATA/jobs" "$MIGRATE_LOG_DIR"
chmod 700 "$MIGRATE_DATA/jobs"

batch_id=$(date +%Y%m%d%H%M%S)
jobs_file=$(mktemp)
batch_log="$MIGRATE_DATA/jobs/batch-${batch_id}.log"
batch_progress="$MIGRATE_DATA/jobs/batch-${batch_id}.progress.json"
echo "$batch_id" >"$MIGRATE_DATA/jobs/last-batch-id"

# Normalize lists
if [[ "$install_php" == "-" || "$install_php" == "none" || -z "$install_php" ]]; then
	install_php=""
fi
if [[ "$remap_php" == "-" || "$remap_php" == "none" || -z "$remap_php" ]]; then
	remap_php=""
fi

sdir=$(session_dir "$session")
need_install_json=$(
python3 - "$sdir" "$@" <<'PY' 2>/dev/null || true
import json, os, sys
sdir, users = sys.argv[1], sys.argv[2:]
needed, remap = set(), set()
for u in users:
    path = os.path.join(sdir, f"analysis-{u}.json")
    if not os.path.isfile(path):
        continue
    try:
        sw = (json.load(open(path, encoding="utf-8")).get("software") or {})
    except Exception:
        continue
    needed.update(sw.get("needs_install") or [])
    remap.update(sw.get("needs_remap") or [])
print(json.dumps({"needs_install": sorted(needed), "needs_remap": sorted(remap)}))
PY
)
if [[ -n "$need_install_json" ]]; then
	needs_install=$(python3 -c 'import json,sys; print(",".join(json.loads(sys.argv[1]).get("needs_install") or []))' "$need_install_json")
	needs_remap=$(python3 -c 'import json,sys; print(",".join(json.loads(sys.argv[1]).get("needs_remap") or []))' "$need_install_json")
	if [[ -n "$needs_remap" && -z "$remap_php" ]]; then
		die_json 5 "PHP remap required ($needs_remap) before import"
	fi
	if [[ -n "$needs_install" ]]; then
		if [[ "$accept_sw" != "yes" ]]; then
			die_json 5 "PHP install required ($needs_install); accept_software=yes and install_php required"
		fi
		if [[ -z "$install_php" ]]; then
			die_json 5 "install_php must list: $needs_install"
		fi
	fi
fi

printf '{"stage":"queued","percent":1,"message":"Batch queued","updated":"%s","batch_id":"%s"}\n' \
	"$(date -Is)" "$batch_id" >"$batch_progress"

{
	echo "#!/bin/bash"
	echo "set +e"
	echo "SESSION=$(printf '%q' "$session")"
	echo "ACCEPT=$(printf '%q' "$accept")"
	echo "ACCEPT_SW=$(printf '%q' "$accept_sw")"
	echo "REMAP_PHP=$(printf '%q' "$remap_php")"
	echo "export MIGRATE_BATCH_PROGRESS=$(printf '%q' "$batch_progress")"
	echo "export MIGRATE_REMAP_PHP=\"\$REMAP_PHP\""
	echo "echo \"[batch $batch_id] start \$(date -Is)\""
	echo "printf '{\"stage\":\"prep\",\"percent\":3,\"message\":\"Preparing software\",\"updated\":\"%s\",\"batch_id\":\"$batch_id\"}\\n' \"\$(date -Is)\" >$(printf '%q' "$batch_progress")"

	if [[ -n "$install_php" ]]; then
		if [[ "$accept_sw" != "yes" ]]; then
			echo "echo \"[batch] refuse: PHP install requested without accept_software\""
			echo "printf '{\"stage\":\"failed\",\"percent\":0,\"message\":\"PHP install requires software consent\",\"updated\":\"%s\",\"batch_id\":\"$batch_id\"}\\n' \"\$(date -Is)\" >$(printf '%q' "$batch_progress")"
			echo "exit 5"
		fi
		# shellcheck disable=SC2086
		echo "versions=\$(echo $(printf '%q' "$install_php") | tr ',' ' ')"
		echo "echo \"[batch] prep PHP: \$versions\""
		echo "/usr/local/hestia-migrate/bin/v-migrate-prep-php \$versions >$(printf '%q' "$MIGRATE_DATA/jobs/batch-${batch_id}.prep.json") 2>>$(printf '%q' "$batch_log")"
		echo "prep_rc=\$?"
		echo "if [[ \$prep_rc -ne 0 ]]; then"
		echo "  echo \"[batch] PHP prep failed\""
		echo "  printf '{\"stage\":\"failed\",\"percent\":0,\"message\":\"PHP prep failed — see batch prep.json / log\",\"updated\":\"%s\",\"batch_id\":\"$batch_id\"}\\n' \"\$(date -Is)\" >$(printf '%q' "$batch_progress")"
		echo "  exit 6"
		echo "fi"
		echo "printf '{\"stage\":\"prep_done\",\"percent\":12,\"message\":\"PHP ready — starting transfers\",\"updated\":\"%s\",\"batch_id\":\"$batch_id\"}\\n' \"\$(date -Is)\" >$(printf '%q' "$batch_progress")"
	else
		echo "printf '{\"stage\":\"prep_done\",\"percent\":8,\"message\":\"No PHP install needed\",\"updated\":\"%s\",\"batch_id\":\"$batch_id\"}\\n' \"\$(date -Is)\" >$(printf '%q' "$batch_progress")"
	fi

	for u in "$@"; do
		echo "echo \"[batch] starting user $(printf '%q' "$u")\""
		echo "printf '{\"stage\":\"transfer\",\"percent\":15,\"message\":\"Transferring $(printf '%q' "$u")\",\"updated\":\"%s\",\"batch_id\":\"$batch_id\",\"user\":\"$(printf '%q' "$u")\"}\\n' \"\$(date -Is)\" >$(printf '%q' "$batch_progress")"
		echo "/usr/local/hestia-migrate/bin/v-migrate-transfer \"\$SESSION\" $(printf '%q' "$u") \"\$ACCEPT\""
		echo "rc=\$?"
		echo "echo \"[batch] user $(printf '%q' "$u") exit \$rc\""
	done
	echo "printf '{\"stage\":\"done\",\"percent\":100,\"message\":\"Batch finished\",\"updated\":\"%s\",\"batch_id\":\"$batch_id\"}\\n' \"\$(date -Is)\" >$(printf '%q' "$batch_progress")"
	echo "echo \"[batch $batch_id] done \$(date -Is)\""
} >"$jobs_file"
chmod 700 "$jobs_file"

nohup bash "$jobs_file" >"$batch_log" 2>&1 &
pid=$!
echo "$pid" >"$MIGRATE_DATA/jobs/batch-${batch_id}.pid"

# Return quickly — do not wait for first user job (prep may take minutes)
users_json=$(printf '%s\n' "$@" | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')
install_json=$(python3 -c 'import json,sys; print(json.dumps([x for x in sys.argv[1].split(",") if x and x not in ("-","none")]))' "$install_php")
printf '{"ok":true,"pid":%s,"batch_id":"%s","first_job":"","batch_log":"%s","batch_progress":"%s","users":%s,"install_php":%s,"message":"batch started"}\n' \
	"$pid" "$batch_id" "$(json_escape "$batch_log")" "$(json_escape "$batch_progress")" "$users_json" "$install_json"
